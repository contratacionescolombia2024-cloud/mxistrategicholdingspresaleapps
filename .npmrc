# Configuración de NPM para el proyecto
# Evita errores comunes de instalación

# Usar resolución estricta de pares
legacy-peer-deps=false

# No guardar el archivo package-lock en el repositorio si se usa yarn
# (descomenta si prefieres yarn)
# package-lock=false

# Timeout aumentado para conexiones lentas
fetch-timeout=300000

# Registros públicos
registry=https://registry.npmjs.org/
